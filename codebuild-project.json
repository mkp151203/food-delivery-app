{
    "name": "food-delivery-frontend-build",
    "description": "Build and deploy Food Delivery frontend",
    "source": {
        "type": "CODEPIPELINE",
        "buildspec": "buildspec.yml"
    },
    "artifacts": {
        "type": "CODEPIPELINE"
    },
    "environment": {
        "type": "LINUX_CONTAINER",
        "image": "aws/codebuild/amazonlinux2-x86_64-standard:5.0",
        "computeType": "BUILD_GENERAL1_SMALL",
        "environmentVariables": [
            {
                "name": "VITE_API_URL",
                "value": "https://gf3w1gt2sf.execute-api.us-east-1.amazonaws.com/prod",
                "type": "PLAINTEXT"
            }
        ]
    },
    "serviceRole": "arn:aws:iam::998718206191:role/CodeBuildFoodDeliveryRole"
}